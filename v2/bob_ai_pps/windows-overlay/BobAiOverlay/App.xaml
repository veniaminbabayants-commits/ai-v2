<Application x:Class="BobAiOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F20B1016"/>
    <SolidColorBrush x:Key="Panel" Color="#FF121A22"/>
    <SolidColorBrush x:Key="Accent" Color="#FF39C6B0"/>
    <SolidColorBrush x:Key="TextMain" Color="#FFF0F5F8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF9EADB9"/>
  </Application.Resources>
</Application>
